---
import { DocsLocalWorkspace } from '@terra-symposium/docs/local-workspace';
import type { DocsLocalPage } from '@terra-symposium/docs/local-workspace';
import type { DocsHostTreeNode } from '@terra-symposium/docs';
import '@terra-symposium/docs/style.css';

import { pages as pageCatalog } from '../../pages.mjs';
export function getStaticPaths() {
	return pageCatalog.map(page => ({ params: { slug: page.slug || undefined }, props: { page } }));
}
const { page } = Astro.props;
const contentFiles = import.meta.glob('../../content/*.md', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const prefix = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs: DocsLocalPage[] = pageCatalog.map(entry => ({
	id: entry.slug || 'index',
	path: `content/${entry.file}`,
	pathname: `${prefix}/${entry.slug}${entry.slug ? '/' : ''}`,
	title: entry.title,
	...(entry.description ? { description: entry.description } : {}),
	markdown: String(contentFiles[`../../content/${entry.file}`] ?? ''),
}));
const tree: DocsHostTreeNode[] = [{
	type: 'branch', origName: 'styling', title: 'Styling', path: 'styling',
	children: [{
		type: 'branch', origName: 'styling/guides', title: 'Guides', path: 'styling/guides',
		children: docs.map(entry => ({ type: 'leaf' as const, origName: entry.id, title: entry.title, path: entry.path, url: entry.pathname, permission: 'read' as const })),
	}],
}];
---
<!doctype html>
<html lang="en">
	<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>{page.title} · Terra Styling</title></head>
	<body>
		<DocsLocalWorkspace client:load tree={tree} pages={docs} pathname={Astro.url.pathname} title="Terra Styling" description="Shared UI components and hue-based themes." rootPath={prefix || '/'} homePath={`${prefix}/`} />
	</body>
</html>
