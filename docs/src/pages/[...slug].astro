---
import { DocsNavigation, renderMarkdown } from '@terra-symposium/docs';
import '@terra-symposium/docs/style.css';

import { pages } from '../../pages.mjs';
export function getStaticPaths() {
  return pages.map(page => ({ params: { slug: page.slug || undefined }, props: { page } }));
}
const { page } = Astro.props;
const contentFiles = import.meta.glob('../../content/*.md', { query: '?raw', import: 'default', eager: true });
const source = contentFiles[`../../content/${page.file}`];
const content = renderMarkdown(source);
const prefix = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = pages.map(item => ({ title: item.title, href: `${prefix}/${item.slug}${item.slug ? '/' : ''}` }));
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>{page.title} · Terra Styling</title></head>
  <body>
    <div class="layout"><aside><a class="brand" href={`${prefix}/`}>Terra Styling</a><DocsNavigation nodes={nav} currentPath={Astro.url.pathname} /></aside><main class="prose" set:html={content} /></div>
  </body>
</html>
<style>
  :global(body){margin:0;font:16px/1.65 system-ui,sans-serif;color:#1f2924;background:#f8faf8}
  .layout{display:grid;grid-template-columns:240px minmax(0,780px);gap:48px;max-width:1120px;margin:auto;padding:40px 24px}
  aside{position:sticky;top:24px;align-self:start}
  .brand{display:block;font-size:20px;font-weight:700;color:#183e2b;margin-bottom:24px;text-decoration:none}
  main{min-width:0}.prose :global(a){color:#185c41}.prose :global(pre){overflow:auto;padding:16px;background:#eaf0eb;border-radius:8px}.prose :global(code){font-family:ui-monospace,monospace}
  @media(max-width:700px){.layout{display:block;padding:20px}aside{position:static;margin-bottom:30px}}
</style>
