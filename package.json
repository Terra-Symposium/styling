{
  "name": "@terra-symposium/styling",
  "version": "0.1.28",
  "description": "Shared Terra UI and hue theming",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./ui/terra-original": {
      "types": "./dist/components/ui/index.d.ts",
      "import": "./dist/components/ui/index.js"
    },
    "./tailwind-preset": {
      "types": "./dist/lib/tailwind-preset.d.ts",
      "import": "./dist/lib/tailwind-preset.js"
    },
    "./docs-base.css": "./dist/docs-base.css",
    "./ui-base.css": "./dist/ui-base.css",
    "./effects.css": "./dist/effects.css",
    "./ui.css": "./dist/ui.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && mkdir -p dist/assets/fonts/licenses && cp src/styles/tokens.css dist/tokens.css && cp src/assets/fonts/*.woff src/assets/fonts/*.woff2 dist/assets/fonts/ && cp src/assets/fonts/README.md dist/assets/fonts/README.md && cp src/assets/fonts/licenses/OFL-1.1.txt dist/assets/fonts/OFL-1.1.txt && cp src/assets/fonts/licenses/Inter-OFL-1.1.txt dist/assets/fonts/licenses/Inter-OFL-1.1.txt && tailwindcss --postcss tailwind.postcss.config.cjs -c tailwind.docs-base.config.mjs -i src/styles/docs-base.css -o dist/docs-base.css --minify && tailwindcss --postcss tailwind.postcss.config.cjs -c tailwind.ui.config.mjs -i src/styles/ui-base.css -o dist/ui-base.css --minify && node scripts/compile-effects.cjs && tailwindcss --postcss tailwind.postcss.config.cjs -c tailwind.ui.config.mjs -i src/styles/ui.css -o dist/ui.css --minify",
    "typecheck": "tsc --noEmit",
    "docs:build": "pnpm build && cd docs && ../node_modules/.bin/astro build",
    "docs:dev": "pnpm build && cd docs && ASTRO_BASE_PATH=/ ../node_modules/.bin/astro dev",
    "test": "pnpm build && tsx --test test/lib/*.test.ts test/components/ui/*.test.ts",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@carbon/icons-react": "11.90.0",
    "@headlessui/tailwindcss": "^0.2.0",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-toolbar": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/typography": "^0.5.12",
    "bezier-easing": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "colorjs.io": "^0.5.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.555.0",
    "react-day-picker": "^9.11.1",
    "react-hook-form": "^7.56.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.3",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-scrim-gradients": "^0.4.2",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@astrojs/react": "^7.1.0",
    "@changesets/cli": "^3.0.3",
    "@terra-symposium/docs": "file:vendor/terra-symposium-docs-0.1.42.tgz",
    "@terra-symposium/styling": "file:vendor/terra-symposium-styling-0.1.27.tgz",
    "@types/bezier-easing": "^2.1.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.2",
    "debug": "4.4.3",
    "husky": "^9.1.7",
    "postcss": "8.5.31",
    "postcss-import": "15.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "use-sync-external-store": "1.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "sideEffects": [
    "./dist/ui.css",
    "./dist/docs-base.css",
    "./dist/ui-base.css",
    "./dist/effects.css"
  ]
}
